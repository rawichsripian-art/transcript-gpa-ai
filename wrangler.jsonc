{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transcript-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public" },
  "ai": { "binding": "AI", "remote": true },
  // 10 extractions per minute per visitor, to stay inside the free daily AI quota
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
